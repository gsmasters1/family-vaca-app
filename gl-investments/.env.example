# G&L Investments — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# ── Alpaca Trading ────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_PAPER=true                    # Keep true until backtests pass Sharpe >= 1.0

# ── Anthropic Claude API (trade review layer) ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Ollama (local AI) ─────────────────────────────────────────────────────
# No key needed — runs locally via Docker
# Model will be pulled automatically on first run

# ── Optional: Real-time price data (upgrade from Yahoo Finance 15min delay) ─
# Get free key at: https://finnhub.io/register
FINNHUB_API_KEY=none

# ── Optional: Telegram trade alerts ──────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the token here
# 3. Message your bot → get chat_id from https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_BOT_TOKEN=none
TELEGRAM_CHAT_ID=none

# ── Optional: Additional data sources ────────────────────────────────────
# Free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=none
# Free at: https://quiverquant.com/
QUIVER_API_KEY=none
