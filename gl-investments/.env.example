# Copy this to .env and fill in values
# Alpha Vantage API key (free tier: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=demo

# Ollama model to use (must be pulled first: ollama pull llama3.1:8b)
OLLAMA_MODEL=llama3.1:8b

# Ollama URL (default works for both local dev and Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Database path (auto-created on first run)
DB_PATH=./database/gl_investments.db
